rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    // 1. User Profile Documents: users/{userId}
    match /users/{userId} {
      // User can read their own profile, Admin can read profile for user management
      allow read: if isOwner(userId) || isAdmin();
      
      // New user creation: Strictly enforce that users CANNOT assign themselves the admin role
      // and schoolId is strictly set to the exclusive supported school
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'user'
      ) && (
        !('schoolId' in request.resource.data) ||
        request.resource.data.schoolId == 'christa-peter-scherpf-gymnasium-prenzlau'
      );

      // User profile update: users cannot modify their own role or schoolId
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId'])
      ) || isAdmin();

      // Deletion: User can delete their own account or Admin can delete user
      allow delete: if isOwner(userId) || isAdmin();

      // 1.1 Private User Subcollections (subjects, teachers, rooms, schedule, substitutions, homework, exams, grades, events, settings)
      // PRIVACY & CONFIDENTIALITY: Strictly isolated to the owner ONLY. Admin CANNOT read or write private student data!
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Central School Configuration Documents: schools/{schoolId}
    // Exclusively for Christa-und-Peter-Scherpf-Gymnasium Prenzlau
    match /schools/{schoolId} {
      // Authenticated users can read the configuration of the supported school
      allow read: if isAuthenticated() && (
        schoolId == 'christa-peter-scherpf-gymnasium-prenzlau'
      );

      // ONLY Admins can create or update school configuration
      allow write: if isAdmin();

      // Subcollections: scheduleConfig, scheduleSettings, holidays, classes, subjects, teachers, rooms
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() && (
          schoolId == 'christa-peter-scherpf-gymnasium-prenzlau'
        );
        allow write: if isAdmin();
      }

      // Nested subcollections: classes/{classId}/timetables/{docId} etc.
      match /classes/{classId}/{subcollection}/{docId} {
        allow read: if isAuthenticated() && (
          schoolId == 'christa-peter-scherpf-gymnasium-prenzlau'
        );
        allow write: if isAdmin();
      }

      // School Audit Logs: Immutable log of school configuration changes
      match /auditLogs/{logId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // 3. Licenses Collection: licenses/{licenseId}
    match /licenses/{licenseId} {
      // Authenticated users can list and query licenses (to find matching codeHash) and get license status
      allow list: if isAuthenticated();
      allow get: if isAuthenticated();

      // Admins can create and delete licenses
      allow create, delete: if isAdmin();

      // License update: Either admin or authenticated user performing valid atomic activation
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.get('status', '') == 'AVAILABLE' &&
        request.resource.data.get('status', '') == 'ACTIVE' &&
        request.resource.data.get('activatedByUid', '') == request.auth.uid
      );
    }

    // 4. Audit Logs Collection: auditLogs/{logId}
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

