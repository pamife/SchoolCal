rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. User Profile Documents: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // New user creation
      allow create: if isOwner(userId);

      // User profile update: users cannot directly grant themselves admin role or alter plan directly without admin or transaction
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      ) || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();

      // User Subcollections (subjects, teachers, schedule, homework, exams, etc.)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Licenses Collection: licenses/{licenseId}
    match /licenses/{licenseId} {
      // Admins can read all; Users can read only if they activated it or are querying by codeHash
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource == null ||
          resource.data.activatedByUid == request.auth.uid ||
          resource.data.status == 'AVAILABLE'
        )
      );

      // Admins can create and delete licenses
      allow create, delete: if isAdmin();

      // License update: Either admin or authenticated user performing valid activation of AVAILABLE license
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'AVAILABLE' &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.activatedByUid == request.auth.uid
      );
    }

    // 3. Audit Logs Collection: auditLogs/{logId} (Append-only audit trail)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
